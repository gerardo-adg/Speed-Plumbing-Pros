---
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import { site } from '../data/site';
const L = site.links;
const items = [
  { key: 'license', href: '', title: 'Licensed & insured', sub: `CSLB Lic. #${site.license}` },
  { key: 'google', href: L.googleReviews, title: 'Google reviews', sub: `${site.rating.value.toFixed(1)} · ${site.rating.count}+ reviews` },
  { key: 'yelp', href: L.yelp, title: 'Yelp', sub: '5-star rated' },
  { key: 'bbb', href: L.bbb, title: 'BBB accredited', sub: 'A+ rating' },
];
---
<section class="creds" aria-labelledby="creds-title">
  <div class="wrap">
    <div class="creds-card">
      <div class="creds-head">
        <h2 id="creds-title">Our credentials</h2>
        <p>Licensed, insured and top-rated by your neighbors.</p>
      </div>
      <ul class="creds-list">
        {items.map((it) => {
          const Tag = it.href ? 'a' : 'div';
          return (
            <li>
              <Tag class="cred" {...(it.href ? { href: it.href, rel: 'noopener' } : {})}>
                <span class="mark" aria-hidden="true">
                  {it.key === 'license' && <span class="mark-shield"><Icon name="shield" /></span>}
                  {it.key === 'google' && <span class="mark-google"><Icon name="g" class="gicon" /><Stars /></span>}
                  {it.key === 'yelp' && <span class="mark-yelp">{[1, 2, 3, 4, 5].map(() => <span><Icon name="star" /></span>)}</span>}
                  {it.key === 'bbb' && <span class="mark-bbb"><span class="b1">BBB</span><span class="b2">A+</span></span>}
                </span>
                <b>{it.title}</b>
                <small>{it.sub}</small>
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
