---
import Icon from './Icon.astro';
import Seal from './Seal.astro';
const values = [
  { icon: 'bolt', t: 'Fast', d: "Plumbing problems don't wait, so neither do we. Same-day appointments and a 24/7 emergency line." },
  { icon: 'shield', t: 'Trustworthy', d: 'Licensed, insured and A+ rated with the BBB. You get a clear price before we start, and no surprises after.' },
  { icon: 'heart', t: 'Friendly', d: 'We explain what we find in plain language, answer every question and treat your home with care.' },
];
---
<section class="section" aria-labelledby="why-title">
  <div class="wrap why">
    <Seal />
    <div>
      <span class="eyebrow">Why Speed Plumbing Pros</span>
      <h2 id="why-title" style="margin-top:14px">The neighbor who knows plumbing</h2>
      <p class="lede" style="margin-top:16px">We're a local, family-owned team. We show up fast, do the job right and treat your home like our own.</p>
      <div class="values">
        {values.map((v) => <div class="value"><div class="ico"><Icon name={v.icon} /></div><div><h3>{v.t}</h3><p>{v.d}</p></div></div>)}
      </div>
    </div>
  </div>
</section>
