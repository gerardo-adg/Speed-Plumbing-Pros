---
// Round badge: the logo inside a ring of trust words.
import { getImage } from 'astro:assets';
import logo from '../assets/logo.png';
const img = await getImage({ src: logo, width: 520 });
---
<div class="seal" aria-hidden="true">
  <svg viewBox="0 0 400 400">
    <defs><path id="ring" d="M200 200m-160 0a160 160 0 1 1 320 0a160 160 0 1 1 -320 0" /></defs>
    <circle cx="200" cy="200" r="196" fill="#111f28" />
    <text font-family="Montserrat, Arial, sans-serif" font-weight="800" font-size="24" letter-spacing="7" fill="#ffffff"><textPath href="#ring">GREATER SACRAMENTO · LICENSED · INSURED · </textPath></text>
    <circle cx="200" cy="200" r="134" fill="#ffffff" />
    <image href={img.src} x="80" y="122" width="240" height="156" preserveAspectRatio="xMidYMid meet" />
  </svg>
</div>
