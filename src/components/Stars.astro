---
import Icon from './Icon.astro';
interface Props { count?: number; label?: string }
const { count = 5, label } = Astro.props;
---
<span class="stars" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  {Array.from({ length: count }).map(() => <Icon name="star" />)}
</span>
