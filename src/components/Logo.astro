---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
/** Official Speed Plumbing Pros badge logo. `width` is the display width in CSS pixels. */
interface Props { width?: number; eager?: boolean }
const { width = 160, eager = false } = Astro.props;
---
<Image src={logo} alt="Speed Plumbing Pros" width={width} densities={[1, 2]} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
