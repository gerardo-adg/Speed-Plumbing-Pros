---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import Credentials from './Credentials.astro';
import { site, telHref } from '../data/site';

// Hero photo: src/assets/hero-van.(jpg|jpeg|png|webp) is picked up automatically.
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/hero-van.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(found)[0]?.default;
---
<section class="hero hero-bg" aria-labelledby="hero-title">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <span class="pill"><Stars /> {site.rating.value.toFixed(1)} on Google · {site.rating.count}+ reviews</span>
      <h1 id="hero-title">Fast, friendly plumbers for <em>Sacramento homes</em></h1>
      <p class="lede">Same-day help for leaks, clogs, water heaters and sewer lines. Clear price before any work starts, and the estimate is free.</p>
      <div class="hero-actions">
        <a class="btn btn-gold" href={telHref}><Icon name="phone" />Call {site.phone}</a>
        <a class="btn btn-ghost" href="#book"><Icon name="cal" />Book online</a>
      </div>
    </div>
  </div>
  <div class="hero-media">
    {photo
      ? <Image src={photo} alt="Speed Plumbing Pros service van crossing the Tower Bridge in Sacramento at sunrise" widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
      : <div class="hero-photo-missing"><Icon name="camera" /><span>Hero photo goes here<br /><code>src/assets/hero-van.jpg</code></span></div>}
  </div>
</section>
<Credentials />
