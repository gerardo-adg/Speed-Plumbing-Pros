---
import { getCollection, getEntry, getEntries, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import RequestForm from '../../components/RequestForm.astro';
import FinalCta from '../../components/FinalCta.astro';
import { breadcrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const jobs = await getCollection('jobs');
  return jobs.map((j) => ({ params: { slug: j.id }, props: { job: j } }));
}
interface Props { job: CollectionEntry<'jobs'> }
const { job } = Astro.props;
const { Content } = await render(job);
const area = await getEntry(job.data.area);
const services = await getEntries(job.data.services);
const path = `/projects/${job.id}`;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Projects', href: '/projects' }, { name: job.data.title, href: path }];
const date = job.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title={job.data.title} description={job.data.summary} schema={[breadcrumbs(crumbs)]}>
  <PageHero crumbs={crumbs} lede={`${area?.data.name ?? 'Sacramento area'}, CA · ${date}`} actions={false}>{job.data.title}</PageHero>
  <section class="section">
    <div class="wrap two-col">
      <article class="prose">
        {job.data.sample && <p class="notice">Sample post migrated from the current site. Replace it with the real write-up and photos.</p>}
        {job.data.photos.length > 0 && <div class="gallery">{job.data.photos.map((p) => <Image src={p.src} alt={p.alt} widths={[400, 800, 1200]} sizes="(min-width: 980px) 40vw, 100vw" />)}</div>}
        <Content />
        <h2>Services on this job</h2>
        <ul class="chip-list">{services.map((s) => <li><a href={`/services/${s.id}`}>{s.data.name}</a></li>)}</ul>
        {area && <p>More work in <a href={`/service-areas/${area.id}`}>{area.data.name}</a>.</p>}
      </article>
      <aside class="sticky-side"><RequestForm heading="Need something similar?" onLight /></aside>
    </div>
  </section>
  <FinalCta />
</Base>
