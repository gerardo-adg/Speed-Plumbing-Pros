---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AreasGrid from '../../components/AreasGrid.astro';
import RecentJobs from '../../components/RecentJobs.astro';
import FinalCta from '../../components/FinalCta.astro';
import { breadcrumbs } from '../../lib/schema';
import { site } from '../../data/site';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Service Areas', href: '/service-areas' }];
---
<Base title="Service Areas | Plumbers in Greater Sacramento" description={`Speed Plumbing Pros serves Sacramento, Roseville, Elk Grove, Folsom, Davis and 20 more cities. Call ${site.phone}.`} schema={[breadcrumbs(crumbs)]}>
  <PageHero crumbs={crumbs} lede="Based in Sacramento and serving homes and businesses across Sacramento, Placer, El Dorado, Yolo and Solano counties.">Plumbers across <em>Greater Sacramento</em></PageHero>
  <section class="section">
    <div class="wrap" style="display:grid;gap:24px">
      <AreasGrid />
      <p style="font-weight:600">Don't see your city? Call {site.phone} and ask.</p>
    </div>
  </section>
  <RecentJobs />
  <FinalCta />
</Base>
