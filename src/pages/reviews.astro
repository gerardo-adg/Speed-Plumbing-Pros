---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reviews from '../components/Reviews.astro';
import FinalCta from '../components/FinalCta.astro';
import { breadcrumbs } from '../lib/schema';
import { site } from '../data/site';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Reviews', href: '/reviews' }];
---
<Base title="Customer Reviews" description={`${site.rating.count}+ five-star Google reviews for ${site.name}, Sacramento's fast, friendly plumbers.`} schema={[breadcrumbs(crumbs)]}>
  <PageHero crumbs={crumbs} lede={`${site.rating.value.toFixed(1)} stars from ${site.rating.count}+ reviews on Google.`}>What our customers <em>say</em></PageHero>
  <Reviews heading="Recent Google reviews" limit={50} />
  <FinalCta />
</Base>
