---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import BookSection from '../components/BookSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Steps from '../components/Steps.astro';
import WhyUs from '../components/WhyUs.astro';
import Reviews from '../components/Reviews.astro';
import Offers from '../components/Offers.astro';
import RecentJobs from '../components/RecentJobs.astro';
import AreasGrid from '../components/AreasGrid.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { business, faqPage } from '../lib/schema';
import { site } from '../data/site';

const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title={`Sacramento Plumber | Fast, Same-Day Plumbing | ${site.name}`}
  description={`Fast, friendly plumbers serving Sacramento and 25 nearby cities. Same-day drain, leak, water heater and sewer repair. $0 estimate fee. Call ${site.phone}.`}
  schema={[business(areas.map((a) => a.data.name)), faqPage(faqs.map((f) => f.data))]}
>
  <Hero />
  <BookSection />

  <section class="section" id="services" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="section-head split">
        <div style="display:grid;gap:14px"><h2 id="svc-title">Plumbing services in Sacramento</h2></div>
        <p class="lede">From a slow kitchen drain to a full repipe, one licensed team handles it. Pick a service to see what's involved.</p>
      </div>
      <ServicesGrid />
    </div>
  </section>

  <Steps />
  <WhyUs />
  <Reviews />
  <Offers />
  <RecentJobs />

  <section class="section" id="areas" aria-labelledby="areas-title">
    <div class="wrap areas">
      <div style="display:grid;gap:16px">
        <h2 id="areas-title">Plumbers across Greater Sacramento</h2>
        <p class="lede">Based in Sacramento and serving homes and businesses from Davis to Placerville and Lincoln to Elk Grove.</p>
        <p style="font-weight:600">Don't see your city? Call <span style="font-variant-numeric:tabular-nums">{site.phone}</span> and ask.</p>
      </div>
      <AreasGrid current="sacramento" />
    </div>
  </section>

  <Faq faqs={faqs} />
  <FinalCta />
</Base>
